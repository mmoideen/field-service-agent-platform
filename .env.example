# Database
DATABASE_URL=postgresql://fieldservice:fieldservice@localhost:5432/fieldservice
POSTGRES_USER=fieldservice
POSTGRES_PASSWORD=fieldservice
POSTGRES_DB=fieldservice

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent Configuration
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
AGENT_CONFIDENCE_THRESHOLD=0.75
HUMAN_OVERRIDE_ENABLED=true

# External Integrations (Mock by default)
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:3001
CALENDAR_INTEGRATION=mock
CRM_INTEGRATION=mock
INVENTORY_INTEGRATION=mock

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true

# Environment
ENVIRONMENT=development

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_MAP_API_KEY=your_map_api_key_here
